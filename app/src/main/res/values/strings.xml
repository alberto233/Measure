    <string name="device_check_session_failed_detail">The device reports support, but opening a session failed. The reason is below; it is usually a permission or an ARCore update in progress.</string>

    <string name="device_check_full">Fully supported</string>
    <string name="device_check_full_detail">ARCore and the Depth API are both available. Everything this app can do, it can do on this phone.</string>

    <string name="device_check_no_depth">Supported, without depth</string>
    <string name="device_check_no_depth_detail">ARCore works but the Depth API is not available, so measuring falls back to detected planes. Corners away from a floor or a wall will be less accurate.</string>

    <string name="device_check_needs_camera">Camera access needed</string>
    <string name="device_check_needs_camera_detail">ARCore is supported. Grant camera access to test the Depth API.</string>

