    <string name="device_check_needs_update">A una actualización de distancia</string>
    <string name="device_check_needs_update_detail">Este móvil está admitido, pero Google Play Services para RA necesita actualizarse.</string>

    <string name="device_check_session_failed">ARCore no arrancó</string>
    <string name="device_check_session_failed_detail">El dispositivo dice que está admitido, pero al abrir una sesión falló. El motivo está abajo; suele ser un permiso o una actualización de ARCore en curso.</string>

    <string name="device_check_full">Totalmente admitido</string>
    <string name="device_check_full_detail">ARCore y la Depth API están disponibles. Todo lo que esta app sabe hacer, lo puede hacer en este móvil.</string>

    <string name="device_check_no_depth">Admitido, sin profundidad</string>
    <string name="device_check_no_depth_detail">ARCore funciona pero la Depth API no está disponible, así que la medición recurre a los planos detectados. Las esquinas alejadas de un suelo o una pared serán menos precisas.</string>

    <string name="device_check_needs_camera">Hace falta acceso a la cámara</string>
