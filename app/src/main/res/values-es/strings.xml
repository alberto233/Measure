    <string name="device_check_failed_detail">No se ha podido preguntar a ARCore si admite este móvil. Eso no es lo mismo que un móvil no admitido, y es muy posible que volver a intentarlo funcione.</string>

    <string name="device_check_unsupported">Este móvil no puede medir</string>
    <string name="device_check_unsupported_detail">ARCore no admite este dispositivo, así que aquí no se puede medir con la cámara. Los planos guardados se pueden seguir abriendo y enviando.</string>

    <string name="device_check_needs_install">A una instalación de distancia</string>
