<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Declared AR Optional rather than AR Required on purpose. An AR Required app will
      not install on a device ARCore does not support, which is exactly the case we most
      need to diagnose. Optional lets the app install anywhere and report the truth.
    -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <!--
      Without this, PackageManager.resolveActivity returns null on Android 11 and later
      whatever is installed, because an app cannot see packages it has not declared an
      interest in. The share code asks whether anything handles a format's exact type
      before falling back to a generic one, and that question is meaningless if the
      answer is always no.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".MeasureApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!--
          Portrait-locked and keeping the screen awake: see CaptureActivity for why both
          are measurement decisions rather than styling ones.
        -->
        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:label="@string/capture_title"
            android:theme="@style/Theme.Measure.Capture" />

        <!-- The home screen. Saved plans do not need a camera to look at. -->
        <activity
            android:name=".ProjectsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Measure.Capture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Measure.Capture" />

        <!--
          Serves exported files to whatever the user shares them with.

          Scoped to one cache directory by export_paths.xml. A provider rooted any wider
          would hand another app a readable path into private storage, database included.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- The device capability report, reachable from the home screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/device_check_title" />
    </application>

</manifest>
